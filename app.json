{
  "expo": {
    "name": "webflix",
    "slug": "webflix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/movie-box.webp",
    "scheme": "webflix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/movie-box.webp",
        "backgroundColor": "#27391C"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/movie-box.webp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/movie-box.webp",
          "imageWidth": 90,
          "resizeMode": "contain",
          "backgroundColor": "#27391C",
          "dark": {
            "image": "./assets/images/movie-box.webp",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#27391C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
